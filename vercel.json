{
  "version": 2,
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "/api/main.py"
    },
    {
      "src": "/(.*)",
      "destination": "/$1"
    }
  ]
}
